# Postgres. Lokalt: `pnpm db:up` starter databasen fra docker-compose.yml.
DATABASE_URL=

# Lang tilfeldig streng, f.eks. fra `openssl rand -hex 32`
PAYLOAD_SECRET=

# Admin-brukeren som seed-skriptet oppretter hvis den ikke finnes
SEED_ADMIN_EMAIL=admin@hylla.test
SEED_ADMIN_PASSWORD=

# Vercel Cron sender denne som "Authorization: Bearer ..." til /api/demo/reset
CRON_SECRET=

# Settes av Vercel når Blob Storage er koblet til prosjektet. Tom = bilder lagres lokalt i /media.
BLOB_READ_WRITE_TOKEN=

# Nettstedets adresse, f.eks. https://hylla.no. Kan stå tom på Vercel (prosjektets URL brukes da).
# Innloggingscookies godtas bare fra denne adressen (og Vercel-forhåndsvisninger).
SERVER_URL=
